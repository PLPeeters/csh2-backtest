{
  "name": "csh2-belgium-backtest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-current-rate-model": "node scripts/check-current-rate-model.mjs",
    "update-current-rate-model": "node scripts/update-current-rate-model.mjs && npm run check-current-rate-model",
    "refresh-data": "node scripts/refresh-static-data.mjs && npm run check-current-rate-model",
    "refresh-csh2": "node scripts/refresh-static-data.mjs --csh2 && npm run check-current-rate-model",
    "refresh-overnight-rates": "node scripts/refresh-static-data.mjs --overnight-rates && npm run check-current-rate-model",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src --ext .ts,.svelte",
    "test:core": "node --test test/*.test.mjs",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=.playwright vitest run --config vitest.config.ts",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright install chromium",
    "test": "npm run test:core && npm run test:ui",
    "verify": "npm run check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0",
    "luxon": "^3.7.2",
    "papaparse": "^5.5.4",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^3.0.0"
  }
}
